{
  "id": "/",
  "name": "Zom's HaRM",
  "short_name": "HaRM",
  "description": "Hardware and Rack Manager",
  "start_url": "/?app=1#/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#12151b",
  "theme_color": "#12151b",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Scan a part", "short_name": "Scan", "url": "/#/scan-part", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Devices", "url": "/#/devices", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "/#/tasks", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] }
  ]
}
